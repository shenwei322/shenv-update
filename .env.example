# 服务监听端口
PORT=8090

# 对外域名，用于后台展示接口地址与 GitHub Actions 回调
PUBLIC_BASE_URL=https://api.shenv.top

# 管理员账号；首次启动时写入 data/state.json，之后以后台改密为准
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe_2026

# token 签名密钥；生产环境必须设置，长度至少 32 字符
SESSION_SECRET=

# GitHub 同步（可选）。后台也可以填 repo / token
GITHUB_REPO=
GITHUB_TOKEN=

# 定时同步密钥，与 GitHub Actions 的 CRON_SECRET 一致
CRON_SECRET=

# 数据目录（file 存储模式）
DATA_DIR=./data

# 可选：把数据存到 GitHub 私有仓库，便于在无持久磁盘的免费平台部署
# STATE_REPO=owner/private-repo
# STATE_TOKEN=ghp_xxx
# STATE_PATH=state.json
# STATE_BRANCH=main
